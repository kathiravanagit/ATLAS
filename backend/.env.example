# Database URL for PostgreSQL
# Format: postgresql://user:password@host:port/database_name
# Supabase: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

DATABASE_URL=postgresql://postgres:password@localhost:5432/sih
# Production mode uses PostgreSQL/Supabase. Set DEMO_MODE=true only for an explicit local SQLite demo.
DEMO_MODE=false
# Set true for HTTPS deployments; keep false only for local HTTP demo mode.
COOKIE_SECURE=false
