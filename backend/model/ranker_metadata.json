{
  "model": "random-forest pointwise ranker (A2.1, serving-time candidate ordering)",
  "serving_role": "orders each case's candidate ATMs by ranker score when ranker.pkl loads; falls back to row-score order when the artifact is absent",
  "features": [
    "distance_from_victim_km",
    "historical_crime_density",
    "atm_type_score",
    "suspect_distance_km",
    "proximity_score",
    "density_score",
    "suspect_proximity",
    "atm_cashout_history",
    "local_hotspot_density"
  ],
  "n_rows": 8565,
  "n_training_cases": 571,
  "params": {
    "n_estimators": 300,
    "min_samples_leaf": 5,
    "class_weight": "balanced",
    "random_state": 42
  },
  "validation_scope": "synthetic holdout only",
  "real_world_validation": false
}
