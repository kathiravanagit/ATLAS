DATABASE_URL=postgresql://postgres:postgres@localhost:5432/atlas
# Supabase (IPv4 pooler; the direct db.* host is IPv6-only):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
REFRESH_SECRET_KEY=change-me-refresh-use-openssl-rand-hex-32
# 32-byte key as 64 hex chars. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost
# Secure refresh cookie; set false only for local HTTP demo mode.
COOKIE_SECURE=true
SSL_CERTFILE=
SSL_KEYFILE=
# DEMO_MODE=false  # Production default; set true only for an explicit local demo.

# Alert dispatch guards (anti-spam; dashboard toasts always on).
# Daily coding: set both false for dashboard-only toasts. Stage demo: enable once, send 1 test, then off.
ALERTS_SMS_ENABLED=true
ALERTS_EMAIL_ENABLED=true
ALERTS_SMS_MAX_PER_DAY=10
ALERTS_EMAIL_MAX_PER_DAY=20
ALERTS_COOLDOWN_MINUTES=45
# SMS via TextBee device gateway (prototype demo channel, not a government SMS system).
SMS_PROVIDER=textbee
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
INVESTIGATOR_PHONE_NUMBER=+91 XXXXXXXXXX
# Email via SMTP with STARTTLS on 587 (prototype notification path; Gmail app password works for demo).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
INVESTIGATOR_EMAIL=
