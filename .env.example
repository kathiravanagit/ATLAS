DATABASE_URL=postgresql://postgres:postgres@localhost:5432/atlas
# Supabase (IPv4 pooler; the direct db.* host is IPv6-only):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
REFRESH_SECRET_KEY=change-me-refresh-use-openssl-rand-hex-32
# 32-byte key as 64 hex chars. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost
SSL_CERTFILE=
SSL_KEYFILE=
# DEMO_MODE=true  # Uncomment only for hackathon demo — disables rate limiting. OFF by default.
